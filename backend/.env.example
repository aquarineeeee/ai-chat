APP_NAME=ai-chat
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=10000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_chat
DB_USER=aichat
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

LOGIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash
KEY_ENCRYPTION_SECRET=replace_with_a_second_long_random_string

DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4.1-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

MEMORY_ENABLED=false
MEMORY_MCP_URL=http://127.0.0.1:8001/mcp
MEMORY_TIMEOUT_SECONDS=20
MEMORY_MAX_CONTEXT_CHARS=3000
MEMORY_WRITE_MAX_CHARS=6000

# Images: persistent private directory, relative to backend/; use one backend worker.
LOCAL_UPLOAD_DIR=./data/uploads
IMAGE_MAX_BYTES=1048576
IMAGE_MAX_PIXELS=25000000
MESSAGE_MAX_IMAGE_BYTES=8388608
MESSAGE_MAX_IMAGE_PIXELS=50000000
UPLOAD_MAX_REQUEST_BYTES=1572864
UPLOAD_MIN_FREE_BYTES=268435456
UPLOAD_RATE_PER_MINUTE=30
UPLOAD_BODY_TIMEOUT_SECONDS=30
IMAGE_DECODE_CONCURRENCY=1
IMAGE_DECODE_TIMEOUT_SECONDS=10
IMAGE_DECODE_MAX_MEMORY_BYTES=268435456
UNATTACHED_ATTACHMENT_TTL_HOURS=24
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=300
VISION_BUFFER_MAX_BYTES=268435456
VISION_ENCODING_CONCURRENCY=1
OPENAI_CHAT_REQUEST_MAX_BYTES=16777216
OPENAI_RESPONSES_REQUEST_MAX_BYTES=16777216
ANTHROPIC_REQUEST_MAX_BYTES=16777216
OPENAI_CHAT_MAX_IMAGES=500
OPENAI_RESPONSES_MAX_IMAGES=500
ANTHROPIC_MAX_IMAGES=100
OPENAI_CHAT_MAX_IMAGE_DIMENSION=0
OPENAI_RESPONSES_MAX_IMAGE_DIMENSION=0
ANTHROPIC_MAX_IMAGE_DIMENSION=8000
VISION_REQUEST_TIMEOUT_SECONDS=90
